# runtime artifacts
__pycache__/
*.py[cod]
data/
*.db
*.tmp
.pytest_cache/
# 仓库内 pytest basetemp（避开 %TEMP% 下的安全删除守卫，见 skill/文档）
# 统一规则：agent/tests/.pytest-* 全部忽略（ms/dbg/full 等各批次临时目录）
agent/tests/.pt/
agent/tests/.pytest-*/
agent_runtime.egg-info/
.playwright-mcp/

# secrets——绝不入库
local_secrets.json

# runtime log
agent_chat_server.log
# 本地起服务时的重定向日志（后端 8720 / 前端 5174）
.backend-*.log
.frontend-*.log

# 诊断件的**生成物**（脚本本身入库，产物不入库）
_diag_final2/
_diag_mcp/*.json
_diag_mcp/*.log
_diag_mcp/*.txt

# temp patch scripts
patch_remove_windowing.py
patch_remove_windowing2.py

# 前端工程（方案 B）
web/node_modules/
web/dist/
web/.vite/
# 本地环境变量（含 token / 直连地址，绝不入库；样例见 web/.env.example）
web/.env.local
web/.env.*.local
# 迁移期原稿留档（仅本地对拍用，不入版本库）
web/_backup_legacy/
# 改造前本地备份（仅本地留档，不入版本库）
*.bak-b4
agent/run/chat.py.bak*
