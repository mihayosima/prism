# runtime artifacts
__pycache__/
*.py[cod]
data/
*.db
*.tmp
.pytest_cache/
# 仓库内 pytest basetemp（避开 %TEMP% 下的安全删除守卫，见 skill/文档）
# 统一规则：agent/tests/.pytest-* 全部忽略（ms/dbg/full 等各批次临时目录）
agent/tests/.pt/
agent/tests/.pytest-*/
# 仓库根下同样可能生成（--basetemp=.pytest-xxx 从项目根跑时）
/.pytest-*/
# 本项目常用的临时 basetemp 前缀（.pt-* / .pt-xxx）。
# ★ 为什么要显式列出：`--basetemp` 是**可任意命名**的，靠 `/.pytest-*/` 兜不住；
# 未忽略时它们会混进 `git status`，几次之后就没人看 status 了。
/.pt-*/
.pt-*/
agent_runtime.egg-info/
.playwright-mcp/

# secrets——绝不入库
local_secrets.json

# runtime log
agent_chat_server.log
# 本地起服务时的重定向日志（后端 8720 / 前端 5174）
# 用 `*.log` 通配而非 `-*.log`：实际落盘名有时是 `.frontend.log`（点号分隔），
# 旧的 `.frontend-*.log` 只覆盖短横线形式，导致点号形式一直漏网、干扰 git status。
.backend*.log
.frontend*.log
# 临时起服务验证时的重定向日志（.scratch*.log 等）
.scratch*.log

# 诊断件的**生成物**（脚本本身入库，产物不入库）
_diag_final2/
# 根目录下一次性的会话诊断转储（如 _diag_recent_session.txt）
/_diag_*.txt
# MCP 桥的一次性诊断脚本与转储：验证完即弃，整目录不入版本库
_diag_mcp/

# 可行性原型（spike）：验证完即弃，不并入主码
_spike/

# temp patch scripts
patch_remove_windowing.py
patch_remove_windowing2.py

# 前端工程（方案 B）
web/node_modules/
web/dist/
web/.vite/
# 本地环境变量（含 token / 直连地址，绝不入库；样例见 web/.env.example）
web/.env.local
web/.env.*.local
# 迁移期原稿留档（仅本地对拍用，不入版本库）
web/_backup_legacy/
# 改造前本地备份（仅本地留档，不入版本库）
*.bak-b4
agent/run/chat.py.bak*
_commit_msg.txt
