{
  "name": "prism-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:sse": "node tools/check-sse-contract.mjs",
    "check:views": "node --max-old-space-size=2048 tools/check-view-switch.mjs",
    "check:cards": "node --max-old-space-size=2048 tools/check-card-payload.mjs",
    "check:functional": "node --max-old-space-size=2048 tools/check-views-functional.mjs",
    "check:asr": "node tools/check-asr-contract.mjs",
    "check:api": "node --max-old-space-size=2048 tools/check-api-contract.mjs",
    "check:direct": "node --max-old-space-size=2048 tools/check-direct-connect.mjs",
    "check:single": "node --max-old-space-size=2048 tools/check-single-port.mjs",
    "check": "npm run typecheck && npm run check:sse && npm run check:cards && npm run check:views && npm run check:functional && npm run check:api && npm run check:asr",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  }
}
